local function newPage(name)
    local p=Instance.new("ScrollingFrame"); p.Name=name; p.Size=UDim2.fromScale(1,1)
    p.BackgroundTransparency=1; p.BorderSizePixel=0; p.ScrollBarThickness=2
    p.ScrollBarImageColor3=T.accent; p.CanvasSize=UDim2.new(0,0,0,0); p.Visible=false; p.Parent=content
    local layout=Instance.new("UIListLayout"); layout.Padding=UDim.new(0,8); layout.SortOrder=Enum.SortOrder.LayoutOrder; layout.Parent=p
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        p.CanvasSize=UDim2.new(0,0,0,layout.AbsoluteContentSize.Y+4)
    end)
    pageMap[name]=p; return p
end

local function row(parent, titleText, descText, kind, initial, key)
    local r=Instance.new("Frame"); r.Size=UDim2.new(1,-3,0,58); r.BackgroundColor3=T.panel
    r.BorderSizePixel=0; r.Parent=parent; round(r,10); outline(r)
    local a=txt(r,titleText,12,T.text,Enum.Font.GothamSemibold); a.Position=UDim2.fromOffset(12,7); a.Size=UDim2.new(1,-110,0,20)
    local b=txt(r,descText,9,T.muted); b.Position=UDim2.fromOffset(12,29); b.Size=UDim2.new(1,-110,0,18)
    
    if kind=="toggle" then
        local track=Instance.new("TextButton"); track.Size=UDim2.fromOffset(42,24); track.Position=UDim2.new(1,-54,.5,-12)
        track.Text=""; track.AutoButtonColor=false; track.BackgroundColor3=initial and T.accent or T.border; track.Parent=r; round(track,12)
        local knob=Instance.new("Frame"); knob.Size=UDim2.fromOffset(18,18); knob.Position=initial and UDim2.new(1,-21,.5,-9) or UDim2.new(0,3,.5,-9)
        knob.BackgroundColor3=Color3.new(1,1,1); knob.BorderSizePixel=0; knob.Parent=track; round(knob,10)
        track.Activated:Connect(function()
            Config[key]=not Config[key]
            tw(track,.15,{BackgroundColor3=Config[key] and T.accent or T.border})
            tw(knob,.15,{Position=Config[key] and UDim2.new(1,-21,.5,-9) or UDim2.new(0,3,.5,-9)})
        end)
    elseif kind == "input" then
        local box=Instance.new("TextBox"); box.Size=UDim2.fromOffset(80,28); box.Position=UDim2.new(1,-92,.5,-14)
        box.BackgroundColor3=T.row; box.Text=tostring(initial); box.TextColor3=T.text
        box.TextSize=12; box.Font=Enum.Font.GothamBold; box.ClearTextOnFocus=false; box.Parent=r; round(box,8)
        box.FocusLost:Connect(function()
            if type(initial) == "number" then
                local num = tonumber(box.Text)
                if num then Config[key] = num else box.Text = tostring(Config[key]) end
            else
                Config[key] = box.Text
            end
        end)
    end
    return r
end

