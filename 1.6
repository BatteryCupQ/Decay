local function tw(obj, sec, props)
    local ok, t = pcall(function()
        local x = TweenService:Create(obj, TweenInfo.new(sec, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props)
        x:Play(); return x
    end)
    return ok and t
end
local function round(o, n)
    local c=Instance.new("UICorner"); c.CornerRadius=UDim.new(0,n or 10); c.Parent=o
end
local function outline(o, col)
    local s=Instance.new("UIStroke"); s.Color=col or T.border; s.Thickness=1; s.Transparency=.15; s.Parent=o
end
local function txt(parent, value, size, color, font)
    local l=Instance.new("TextLabel"); l.BackgroundTransparency=1; l.Text=value
    l.TextSize=size or 13; l.TextColor3=color or T.text; l.Font=font or Enum.Font.Gotham
    l.TextXAlignment=Enum.TextXAlignment.Left; l.TextYAlignment=Enum.TextYAlignment.Center
    l.Parent=parent; return l
end

