local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local Camera = workspace.CurrentCamera
local player = Players.LocalPlayer

local DS = _G.DS
if not DS or not DS.Gui or not DS.Config then return end
local Config = DS.Config
local T = DS.Theme
local gui = DS.Gui

-- NOCLIP
RunService.Stepped:Connect(function()
    if Config.Noclip and player.Character then
        for _, p in ipairs(player.Character:GetDescendants()) do
            if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
        end
    end
end)

-- ТЕЛЕПОРТ
DS.TPToPlayer = function(targetName)
    local target = Players:FindFirstChild(targetName)
    if not target or not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then
        DS.Toast("Teleport", "Target not found.", T.red); return
    end
    local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local targetCF = target.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 2.5)
    
    if Config.TP_Safe then
        DS.Toast("Teleport", "Safe TP", T.accent)
        task.spawn(function()
            local startCF = myRoot.CFrame
            local dist = (targetCF.Position - startCF.Position).Magnitude
            local steps = math.clamp(math.ceil(dist / 12), 5, 50) 
            for i = 1, steps do
                if not myRoot or not myRoot.Parent then break end
                myRoot.CFrame = startCF:Lerp(targetCF, i / steps)
                myRoot.AssemblyLinearVelocity = Vector3.zero
                task.wait(0.04)
            end
        end)
    else
        myRoot.CFrame = targetCF
        DS.Toast("Teleport", "Teleported", T.green)
    end
end

-- KILL FLOOR
local killFloorY = -40
local killFloorBodyPos = nil
RunService.Heartbeat:Connect(function()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    if Config.KillFloor and hrp and hum then
        hum.PlatformStand = false
        if not killFloorBodyPos or not killFloorBodyPos.Parent then
            killFloorBodyPos = Instance.new("BodyPosition")
            killFloorBodyPos.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            killFloorBodyPos.Position = Vector3.new(hrp.Position.X, killFloorY, hrp.Position.Z)
            killFloorBodyPos.Parent = hrp
        else killFloorBodyPos.Position = Vector3.new(hrp.Position.X, killFloorY, hrp.Position.Z) end
        for _, p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end end
    elseif not Config.KillFloor and killFloorBodyPos then
        killFloorBodyPos:Destroy(); killFloorBodyPos = nil
        if char then
            for _, p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") and not p.CanCollide then p.CanCollide = true end end
            if hum then
                hum.PlatformStand = false
                if hrp then hrp.CFrame = hrp.CFrame + Vector3.new(0, 40, 0) end
            end
        end
        DS.Toast("Kill Floor", "Disabled.", T.green)
    end
end)

-- GUNS: FAST RELOAD & NO RECOIL
local function getGun()
    local char = player.Character
    if not char then return nil end
    for _, v in ipairs(char:GetChildren()) do
        if v:IsA("Tool") then return v end
    end
    return nil
end

task.spawn(function()
    while task.wait(0.1) do
        if Config.FastReload then
            local gun = getGun()
            if gun then
                for _, v in ipairs(gun:GetDescendants()) do
                    if v:IsA("NumberValue") or v:IsA("IntValue") then
                        local n = v.Name:lower()
                        if n:find("reload") or n:find("cooldown") or n:find("delay") then
                            v.Value = 0
                        end
                    end
                end
                local char = player.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local animator = hum and hum:FindFirstChildOfClass("Animator")
                if animator then
                    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                        if track.Animation.Name:lower():find("reload") then track.Speed = 10 end
                    end
                end
            end
        end
    end
end)

RunService.RenderStepped:Connect(function()
    if not Config.NoRecoil then return end
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then hum.CameraOffset = Vector3.new(0, 0, 0) end
end)

-- VISUALS: DARK SKY
local originalSky = nil
RunService.Heartbeat:Connect(function()
    local sky = Lighting:FindFirstChildOfClass("Sky")
    if Config.DarkSky then
        if not originalSky then
            if sky then
                originalSky = sky.SkyboxBk
                sky.SkyboxBk = ""; sky.SkyboxDn = ""; sky.SkyboxFt = ""; sky.SkyboxLf = ""; sky.SkyboxRt = ""; sky.SkyboxUp = ""
            end
            Lighting.Ambient = Color3.fromRGB(10, 10, 20)
            Lighting.OutdoorAmbient = Color3.fromRGB(20, 20, 30)
            Lighting.Brightness = 0.5
        end
    else
        if originalSky then
            if sky then
                sky.SkyboxBk = originalSky; sky.SkyboxDn = originalSky; sky.SkyboxFt = originalSky
                sky.SkyboxLf = originalSky; sky.SkyboxRt = originalSky; sky.SkyboxUp = originalSky
            end
            Lighting.Ambient = Color3.fromRGB(128, 128, 128)
            Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
            Lighting.Brightness = 2
            originalSky = nil
        end
    end
end)

-- VISUALS: CHAMS GUNS
local gunChams = {}
RunService.RenderStepped:Connect(function()
    local gun = getGun()
    if Config.ChamsGun and gun then
        for _, p in ipairs(gun:GetDescendants()) do
            if p:IsA("BasePart") and not gunChams[p] then
                local hl = Instance.new("Highlight")
                hl.Name = "GunCham"; hl.Adornee = p
                hl.FillColor = Color3.fromRGB(255, 0, 0); hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                hl.FillTransparency = 0.5; hl.OutlineTransparency = 0; hl.Parent = gui
                
                local light = Instance.new("PointLight")
                light.Color = Color3.fromRGB(255, 0, 0); light.Range = 5; light.Brightness = 2; light.Parent = p
                gunChams[p] = {hl = hl, light = light}
            end
        end
    elseif not Config.ChamsGun then
        for p, data in pairs(gunChams) do
            if data.hl and data.hl.Parent then data.hl:Destroy() end
            if data.light and data.light.Parent then data.light:Destroy() end
        end
        table.clear(gunChams)
    end
end)

-- WORLD: TIME & GRASS
RunService.Heartbeat:Connect(function()
    if Config.World_Day then 
        if math.abs(Lighting.ClockTime - 14) > 0.1 then Lighting.ClockTime = 14 end
    else 
        if math.abs(Lighting.ClockTime - 0) > 0.1 then Lighting.ClockTime = 0 end 
    end
end)

local hiddenGrass, grassState = {}, nil
RunService.Heartbeat:Connect(function()
    if grassState ~= Config.World_NoGrass then
        grassState = Config.World_NoGrass
        if grassState then
            workspace.Terrain.Decoration = false
            for _, v in ipairs(workspace:GetDescendants()) do
                if v:IsA("BasePart") and (v.Name:lower():find("grass") or v.Name:lower():find("foliage")) then
                    if not hiddenGrass[v] then hiddenGrass[v] = {T = v.Transparency, C = v.CanCollide}; v.Transparency = 1; v.CanCollide = false end
                end
            end
        else
            for v, data in pairs(hiddenGrass) do if v and v.Parent then v.Transparency = data.T; v.CanCollide = data.C end end
            table.clear(hiddenGrass)
        end
    end
end)

-- AUTO LOOT & ITEM ESP
local lootCooldown = 0
RunService.Heartbeat:Connect(function()
    if not Config.AutoLoot or tick() < lootCooldown then return end
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") and v.Enabled then
            local part = v.Parent
            if part and part:IsA("BasePart") and (part.Position - hrp.Position).Magnitude <= 50 then
                lootCooldown = tick() + 0.5
                local oldCF = hrp.CFrame
                hrp.CFrame = part.CFrame
                pcall(function() fireproximityprompt(v) end)
                task.wait(0.1)
                if hrp and hrp.Parent then hrp.CFrame = oldCF end
                break
            end
        end
    end
end)

local itemDrawings, itemCache = {}, {}
workspace.DescendantAdded:Connect(function(inst)
    if Config.Item_Enabled and (inst:IsA("BasePart") or inst:IsA("Model")) and inst.Name:lower():find(Config.Item_Filter:lower()) then
        table.insert(itemCache, inst)
    end
end)

RunService.RenderStepped:Connect(function()
    if not Config.Item_Enabled then 
        for _, v in pairs(itemDrawings) do if v.text then v.text.Visible = false; v.square.Visible = false end end
        return 
    end
    local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local validItems = {}
    for i = #itemCache, 1, -1 do if not itemCache[i].Parent then table.remove(itemCache, i) end end
    for _, v in ipairs(itemCache) do
        local part = v:IsA("BasePart") and v or v:FindFirstChildWhichIsA("BasePart")
        if part and v.Name:lower():find(Config.Item_Filter:lower()) then
            local dist = (part.Position - myRoot.Position).Magnitude
            if dist <= 250 then
                local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen and sp.Z > 0 then validItems[v] = { pos = Vector2.new(sp.X, sp.Y), dist = dist, name = v.Name } end
            end
        end
    end
    local useDrawing = pcall(function() return Drawing.new("Text") end)
    for v, data in pairs(validItems) do
        if not itemDrawings[v] and useDrawing then
            local txtObj = Drawing.new("Text"); txtObj.Size = 14; txtObj.Color = Color3.fromRGB(255, 220, 50)
            txtObj.Center = true; txtObj.Outline = true; txtObj.OutlineColor = Color3.new(0,0,0)
            local sq = Drawing.new("Square"); sq.Thickness = 1; sq.Color = Color3.fromRGB(255, 220, 50); sq.Filled = false
            itemDrawings[v] = { text = txtObj, square = sq }
        end
        if itemDrawings[v] and useDrawing then
            local d = itemDrawings[v]
            d.text.Text = data.name .. " [" .. math.floor(data.dist) .. "m]"
            d.text.Position = Vector2.new(data.pos.X, data.pos.Y - 20); d.text.Visible = true
            d.square.Size = Vector2.new(10, 10); d.square.Position = Vector2.new(data.pos.X - 5, data.pos.Y - 5); d.square.Visible = true
        end
    end
    for v, d in pairs(itemDrawings) do 
        if not validItems[v] and useDrawing then d.text.Visible = false; d.square.Visible = false end 
    end
end)

Players.PlayerAdded:Connect(function() if DS.RefreshTP then DS.RefreshTP() end end)
Players.PlayerRemoving:Connect(function() task.wait(0.1); if DS.RefreshTP then DS.RefreshTP() end end)

