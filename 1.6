function DS.GetClosestPlayer()
    local target, minDist = nil, Config.Aim_FOV
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local myChar = player.Character
    local myHead = myChar and myChar:FindFirstChild("Head")
    if not myHead then return nil end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            local head = plr.Character:FindFirstChild("Head")
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if head and hum and hum.Health > 0 then
                local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen and screenPos.Z > 0 then
                    local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                    local dist3d = (head.Position - myHead.Position).Magnitude
                    if screenDist < minDist and dist3d <= Config.Aim_Range then
                        minDist = screenDist; target = head; target.Parent = plr.Character
                    end
                end
            end
        end
    end
    if target and Config.Aim_Visible then
        local rayParam = RaycastParams.new()
        rayParam.FilterDescendantsInstances = {player.Character, target.Parent}
        rayParam.FilterType = Enum.RaycastFilterType.Exclude
        if workspace:Raycast(Camera.CFrame.Position, target.Position - Camera.CFrame.Position, rayParam) then return nil end
    end
    return target
end

RunService:BindToRenderStep("AimbotCam", Enum.RenderPriority.Camera.Value + 1, function(dt)
    if not Config.Aim_Enabled then return end
    local target = DS.GetClosestPlayer()
    if target then
        local aimPos = target.Position
        if Config.Aim_Projectile then
            local camPos = Camera.CFrame.Position
            local targetVel = target.AssemblyLinearVelocity or Vector3.zero
            local dist = (target.Position - camPos).Magnitude
            local travelTime = dist / math.max(Config.Aim_ProjSpeed, 1)
            local predictedPos = target.Position + (targetVel * travelTime)
            local gravityDrop = 0.5 * 196.2 * (travelTime * travelTime)
            aimPos = predictedPos + Vector3.new(0, gravityDrop, 0)
        end
        local targetCF = CFrame.lookAt(Camera.CFrame.Position, aimPos)
        Camera.CFrame = Camera.CFrame:Lerp(targetCF, math.clamp(Config.Aim_Smooth, 0.01, 1))
    end
end)

-- SILENT AIM
if hookfunction then
    local oldRay = workspace.FindPartOnRayWithIgnoreList
    if oldRay then
        hookfunction(oldRay, function(self, ray, ignore, ...)
            if Config.SilentAim and not checkcaller() then
                local t = DS.GetClosestPlayer()
                if t then
                    local newDir = (t.Position - ray.Origin).Unit * ray.Direction.Magnitude
                    return oldRay(self, Ray.new(ray.Origin, newDir), ignore, ...)
                end
            end
            return oldRay(self, ray, ignore, ...)
        end)
    end
    local oldCast = workspace.Raycast
    if oldCast then
        hookfunction(oldCast, function(self, origin, direction, params)
            if Config.SilentAim and not checkcaller() then
                local t = DS.GetClosestPlayer()
                if t then
                    local newDir = (t.Position - origin).Unit * direction.Magnitude
                    return oldCast(self, origin, newDir, params)
                end
            end
            return oldCast(self, origin, direction, params)
        end)
    end
end

-- SPINBOT
local spinAngle = 0
RunService.Heartbeat:Connect(function(dt)
    if not Config.Spinbot then return end
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    spinAngle = spinAngle + (dt * 25)
    hrp.CFrame = CFrame.new(hrp.CFrame.Position) * CFrame.Angles(0, spinAngle, 0)
end)

-- ESP ОТРИСОВКА
RunService.RenderStepped:Connect(function()
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    if Config.Aim_Enabled and Config.Aim_ShowFOV then
        fovCircle.Visible = true; fovCircle.Position = UDim2.new(0, center.X, 0, center.Y)
        fovCircle.Size = UDim2.new(0, Config.Aim_FOV * 2, 0, Config.Aim_FOV * 2)
    else fovCircle.Visible = false end

    if Config.ESP_Enabled then
        local myChar = player.Character
        local myPos = myChar and myChar:FindFirstChild("HumanoidRootPart") and myChar.HumanoidRootPart.Position
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr == player then continue end
            local char, hum = plr.Character, plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local head = char and char:FindFirstChild("Head")
            if char and hum and hum.Health > 0 and root and head then
                local topPos, topOn = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                local botPos, botOn = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 2.8, 0))
                if topOn and botOn and topPos.Z > 0 then
                    local e = espData[plr]
                    if not e then
                        e = { box = Instance.new("Frame", espLayer), stroke = Instance.new("UIStroke"), name = Instance.new("TextLabel"), dist = Instance.new("TextLabel") }
                        e.box.BackgroundTransparency = 1; e.box.BorderSizePixel = 0
                        e.stroke.Color = T.accent; e.stroke.Parent = e.box
                        e.name.BackgroundTransparency = 1; e.name.TextColor3 = T.text
                        e.name.Font = Enum.Font.GothamBold; e.name.TextSize = 12; e.name.TextStrokeTransparency = 0
                        e.name.Size = UDim2.new(0, 150, 0, 15); e.name.Position = UDim2.new(0.5, -75, -1.2, 0); e.name.Parent = e.box
                        e.dist.BackgroundTransparency = 1; e.dist.TextColor3 = T.muted
                        e.dist.Font = Enum.Font.Gotham; e.dist.TextSize = 11; e.dist.TextStrokeTransparency = 0
                        e.dist.Size = UDim2.new(0, 150, 0, 15); e.dist.Position = UDim2.new(0.5, -75, 1, 2); e.dist.Parent = e.box
                        espData[plr] = e
                    end
                    local h = math.abs(botPos.Y - topPos.Y); local w = h * 0.6
                    e.box.Visible = Config.ESP_Box; e.box.Position = UDim2.new(0, topPos.X - (w/2), 0, topPos.Y); e.box.Size = UDim2.new(0, w, 0, h)
                    e.name.Visible = Config.ESP_Name; e.name.Text = plr.Name
                    e.dist.Visible = Config.ESP_Dist; local d = myPos and math.floor((root.Position - myPos).Magnitude) or 0; e.dist.Text = d .. "m"
                elseif espData[plr] then espData[plr].box.Visible = false end
            elseif espData[plr] then espData[plr].box.Visible = false end
        end
    else for _, e in pairs(espData) do e.box.Visible = false end end

    if Config.ESP_3D then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr == player or not plr.Character then continue end
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
