local function makeTab(name)
    local btn = Instance.new("TextButton")
    btn.Size, btn.BackgroundColor3, btn.BackgroundTransparency = UDim2.new(1, -10, 0, 30), Theme.Tab, 1
    btn.Text, btn.TextColor3, btn.Font, btn.TextSize = name, Theme.TextDim, Enum.Font.GothamBold, 13
    btn.Parent = Side; Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    local container = Instance.new("ScrollingFrame")
    container.Size, container.BackgroundTransparency, container.Visible = UDim2.new(1, 0, 1, 0), 1, false
    container.Parent = Content
    return btn, container
end

