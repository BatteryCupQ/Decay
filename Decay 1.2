local function makeToggle(parent, text, key, y)
    local row = Instance.new("Frame"); row.Size, row.BackgroundTransparency, row.Position = UDim2.new(1, 0, 0, 26), 1, UDim2.new(0,0,0,y); row.Parent = parent
    local lbl = Instance.new("TextLabel"); lbl.Size, lbl.BackgroundTransparency, lbl.Text = UDim2.new(1, -50, 1, 0), 1, text
    lbl.TextColor3, lbl.Font, lbl.TextSize, lbl.TextXAlignment = Theme.Text, Enum.Font.Gotham, 12, Enum.TextXAlignment.Left; lbl.Parent = row

    local track = Instance.new("Frame"); track.Size, track.Position = UDim2.new(0, 32, 0, 18), UDim2.new(1, -32, 0.5, -9)
    track.BackgroundColor3 = C[key] and Theme.Green or Theme.Tab; track.Parent = row; Instance.new("UICorner", track).CornerRadius = UDim.new(0.5, 0)
    local knob = Instance.new("Frame"); knob.Size, knob.BackgroundColor3 = UDim2.new(0, 14, 0, 14), Color3.new(1,1,1)
    knob.Position = C[key] and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7); knob.Parent = track
    Instance.new("UICorner", knob).CornerRadius = UDim.new(0.5, 0)

    local btn = Instance.new("TextButton"); btn.Size, btn.BackgroundTransparency, btn.Text = UDim2.new(1,0,1,0), 1, ""; btn.Parent = row
    btn.MouseButton1Click:Connect(function()
        C[key] = not C[key]
        track.BackgroundColor3 = C[key] and Theme.Green or Theme.Tab
        knob:TweenPosition(C[key] and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7), "Out", "Quad", 0.1, true)
    end)
end

local function makeInput(parent, text, key, y, isString)
    local row = Instance.new("Frame"); row.Size, row.BackgroundTransparency, row.Position = UDim2.new(1, 0, 0, 26), 1, UDim2.new(0,0,0,y); row.Parent = parent
    local lbl = Instance.new("TextLabel"); lbl.Size, lbl.BackgroundTransparency, lbl.Text = UDim2.new(1, -100, 1, 0), 1, text
    lbl.TextColor3, lbl.Font, lbl.TextSize, lbl.TextXAlignment = Theme.Text, Enum.Font.Gotham, 12, Enum.TextXAlignment.Left; lbl.Parent = row

    local box = Instance.new("TextBox"); box.Size, box.Position = UDim2.new(0, 90, 0, 22), UDim2.new(1, -90, 0.5, -11)
    box.BackgroundColor3, box.Text, box.TextColor3 = Theme.Tab, tostring(C[key]), Theme.Text
    box.Font, box.TextSize, box.ClearTextOnFocus = Enum.Font.Code, 11, false; box.Parent = row
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 4)

    box.FocusLost:Connect(function()
        if isString then C[key] = box.Text
        else local num = tonumber(box.Text); if num then C[key] = num else box.Text = tostring(C[key]) end end
    end)
end

