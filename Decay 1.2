-- LOGIC
local function getClosestPlayer()
    local target, minDist = nil, C.Aim_FOV
    local vpSize = Camera.ViewportSize
    local center = Vector2.new(vpSize.X / 2, vpSize.Y / 2)
    local myChar = LP.Character
    local myHead = myChar and myChar:FindFirstChild("Head")
    if not myHead then return nil end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local head = plr.Character:FindFirstChild("Head")
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if head and hum and hum.Health > 0 then
                local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen and screenPos.Z > 0 then
                    local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                    local dist3d = (head.Position - myHead.Position).Magnitude
                    if screenDist < minDist and dist3d <= C.Aim_Range then
                        minDist = screenDist; target = head; target.Parent = plr.Character
                    end
                end
            end
        end
    end
    if target and C.Aim_Visible then
        local rayParam = RaycastParams.new()
        rayParam.FilterDescendantsInstances = {LP.Character, target.Parent}
        rayParam.FilterType = Enum.RaycastFilterType.Exclude
        local hit = workspace:Raycast(Camera.CFrame.Position, target.Position - Camera.CFrame.Position, rayParam)
        if hit then return nil end
    end
    return target
end

-- AIMBOT (с предсказанием)
RunService:BindToRenderStep("AimbotCam", Enum.RenderPriority.Camera.Value + 1, function(dt)
    if not C.Aim_Enabled then return end
    local target = getClosestPlayer()
    if target then
        local aimPos = target.Position
        if C.Aim_Projectile then
            local camPos = Camera.CFrame.Position
            local targetVel = target.AssemblyLinearVelocity or Vector3.zero
            local dist = (target.Position - camPos).Magnitude
            local travelTime = dist / math.max(C.Aim_ProjSpeed, 1)
            local predictedPos = target.Position + (targetVel * travelTime)
            local gravityDrop = 0.5 * 196.2 * (travelTime * travelTime)
            aimPos = predictedPos + Vector3.new(0, gravityDrop, 0)
        end
        local targetCF = CFrame.lookAt(Camera.CFrame.Position, aimPos)
        Camera.CFrame = Camera.CFrame:Lerp(targetCF, math.clamp(C.Aim_Smooth, 0.01, 1))
    end
end)

-- WORLD / DAY-NIGHT
RunService.Heartbeat:Connect(function()
    if C.World_Day then if math.abs(Lighting.ClockTime - 14) > 0.1 then Lighting.ClockTime = 14 end
    else if math.abs(Lighting.ClockTime - 0) > 0.1 then Lighting.ClockTime = 0 end end
end)

-- GRASS REMOVAL
local hiddenGrass, grassState = {}, nil
RunService.Heartbeat:Connect(function()
    if grassState ~= C.World_NoGrass then
        grassState = C.World_NoGrass
        if grassState then
            workspace.Terrain.Decoration = false
            for _, v in ipairs(workspace:GetDescendants()) do
                if v:IsA("BasePart") and (v.Name:lower():find("grass") or v.Name:lower():find("foliage")) then
                    if not hiddenGrass[v] then hiddenGrass[v] = {T = v.Transparency, C = v.CanCollide}; v.Transparency = 1; v.CanCollide = false end
                end
            end
        else
            for v, data in pairs(hiddenGrass) do if v and v.Parent then v.Transparency = data.T; v.CanCollide = data.C end end
            table.clear(hiddenGrass)
        end
    end
end)

-- AUTO LOOT (АБУЗ)
local lootCooldown = 0
RunService.Heartbeat:Connect(function()
    if not C.AutoLoot or tick() < lootCooldown then return end
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") and v.Enabled then
            local part = v.Parent
            if part and part:IsA("BasePart") then
                local dist = (part.Position - hrp.Position).Magnitude
                if dist <= 50 then
                    lootCooldown = tick() + 0.5
                    local oldCF = hrp.CFrame
                    hrp.CFrame = part.CFrame
                    pcall(function() fireproximityprompt(v) end)
                    task.wait(0.1)
                    if hrp and hrp.Parent then hrp.CFrame = oldCF end
                    break
                end
            end
        end
    end
end)

-- ITEM ESP CACHE
workspace.DescendantAdded:Connect(function(inst)
    if C.Item_Enabled and (inst:IsA("BasePart") or inst:IsA("Model")) then
        if inst.Name:lower():find(C.Item_Filter:lower()) then table.insert(itemCache, inst) end
    end
end)

-- MAIN RENDER LOOP (ESP)
RunService.RenderStepped:Connect(function()
    local vpSize = Camera.ViewportSize
    local center = Vector2.new(vpSize.X / 2, vpSize.Y / 2)

    if C.Aim_Enabled and C.Aim_ShowFOV then
        fovCircle.Visible = true
        fovCircle.Position = UDim2.new(0, center.X, 0, center.Y)
        fovCircle.Size = UDim2.new(0, C.Aim_FOV * 2, 0, C.Aim_FOV * 2)
    else fovCircle.Visible = false end

    if C.ESP_Enabled then
        local myChar = LP.Character
        local myPos = myChar and myChar:FindFirstChild("HumanoidRootPart") and myChar.HumanoidRootPart.Position

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr == LP then continue end
            local char = plr.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local head = char and char:FindFirstChild("Head")

            if char and hum and hum.Health > 0 and root and head then
                local topPos, topOn = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                local botPos, botOn = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 2.8, 0))

                if topOn and botOn and topPos.Z > 0 then
                    local e = espData[plr]
                    if not e then
                        e = { box = Instance.new("Frame", drawLayer), stroke = Instance.new("UIStroke"), name = Instance.new("TextLabel"), dist = Instance.new("TextLabel") }
                        e.box.BackgroundTransparency = 1; e.box.BorderSizePixel = 0
                        e.stroke.Color = Color3.fromRGB(255, 60, 60); e.stroke.Parent = e.box
                        e.name.BackgroundTransparency = 1; e.name.TextColor3 = Color3.new(1,1,1)
                        e.name.Font = Enum.Font.GothamBold; e.name.TextSize = 12; e.name.TextStrokeTransparency = 0
                        e.name.Size = UDim2.new(0, 150, 0, 15); e.name.Position = UDim2.new(0.5, -75, -1.2, 0); e.name.Parent = e.box
                        e.dist.BackgroundTransparency = 1; e.dist.TextColor3 = Color3.fromRGB(220,220,220)
                        e.dist.Font = Enum.Font.Gotham; e.dist.TextSize = 11; e.dist.TextStrokeTransparency = 0
                        e.dist.Size = UDim2.new(0, 150, 0, 15); e.dist.Position = UDim2.new(0.5, -75, 1, 2); e.dist.Parent = e.box
                        espData[plr] = e
                    end
                    local h = math.abs(botPos.Y - topPos.Y); local w = h * 0.6
                    e.box.Visible = C.ESP_Box; e.box.Position = UDim2.new(0, topPos.X - (w/2), 0, topPos.Y); e.box.Size = UDim2.new(0, w, 0, h)
                    e.name.Visible = C.ESP_Name; e.name.Text = plr.Name
                    e.dist.Visible = C.ESP_Dist; local d = myPos and math.floor((root.Position - myPos).Magnitude) or 0; e.dist.Text = d .. "m"
                else
                    if espData[plr] then espData[plr].box.Visible = false end
                end
            else
                if espData[plr] then espData[plr].box.Visible = false end
            end
        end
    else
        for _, e in pairs(espData) do e.box.Visible = false end
    end

    -- ITEM ESP
    if not C.Item_Enabled then 
        for _, v in pairs(itemDrawings) do if v.text then v.text.Visible = false; v.square.Visible = false end end
        return 
    end
    local myChar = LP.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    local validItems = {}
    for i = #itemCache, 1, -1 do if not itemCache[i].Parent then table.remove(itemCache, i) end end

    for _, v in ipairs(itemCache) do
        local part = v:IsA("BasePart") and v or v:FindFirstChildWhichIsA("BasePart")
        if part and v.Name:lower():find(C.Item_Filter:lower()) then
            local dist = (part.Position - myRoot.Position).Magnitude
            if dist <= 250 then
                local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen and sp.Z > 0 then validItems[v] = { pos = Vector2.new(sp.X, sp.Y), dist = dist, name = v.Name } end
            end
        end
    end

    local useDrawing = pcall(function() return Drawing.new("Text") end)
    for v, data in pairs(validItems) do
        if not itemDrawings[v] and useDrawing then
            local txt = Drawing.new("Text"); txt.Size = 14; txt.Color = Color3.fromRGB(255, 220, 50)
            txt.Center = true; txt.Outline = true; txt.OutlineColor = Color3.new(0,0,0)
            local sq = Drawing.new("Square"); sq.Thickness = 1; sq.Color = Color3.fromRGB(255, 220, 50); sq.Filled = false
            itemDrawings[v] = { text = txt, square = sq }
        end
        if itemDrawings[v] and useDrawing then
            local d = itemDrawings[v]
            d.text.Text = data.name .. " [" .. math.floor(data.dist) .. "m]"
            d.text.Position = Vector2.new(data.pos.X, data.pos.Y - 20); d.text.Visible = true
            d.square.Size = Vector2.new(10, 10); d.square.Position = Vector2.new(data.pos.X - 5, data.pos.Y - 5); d.square.Visible = true
        end
    end
    for v, d in pairs(itemDrawings) do 
        if not validItems[v] and useDrawing then d.text.Visible = false; d.square.Visible = false end 
    end
end)

Players.PlayerRemoving:Connect(function(plr)
    if espData[plr] then espData[plr].box:Destroy(); espData[plr] = nil end
end)

