local WorldBtn, WorldTab = makeTab("World")
local MiscBtn, MiscTab = makeTab("Misc")

local activeTab = AimBtn; AimTab.Visible = true; AimBtn.TextColor3 = Theme.Text; AimBtn.BackgroundTransparency = 0
local function switchTab(btn)
    if activeTab == btn then return end
    for _, t in ipairs({AimBtn, EspBtn, WorldBtn, MiscBtn}) do t.TextColor3 = Theme.TextDim; t.BackgroundTransparency = 1 end
    btn.TextColor3 = Theme.Text; btn.BackgroundTransparency = 0
    AimTab.Visible = (btn == AimBtn); EspTab.Visible = (btn == EspBtn)
    WorldTab.Visible = (btn == WorldBtn); MiscTab.Visible = (btn == MiscBtn)
    activeTab = btn
end
AimBtn.MouseButton1Click:Connect(function() switchTab(AimBtn) end)
