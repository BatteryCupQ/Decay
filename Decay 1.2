-- DRAG
local dragging, dragStart, startPos
local function updateDrag(input)
    local delta = input.Position - dragStart
    Main.Position = Main.Position:Lerp(UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y), 0.5)
end
TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true; dragStart = input.Position; startPos = Main.Position
        input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then updateDrag(input) end
end)

-- OPEN/CLOSE
local isOpen = true
local FloatBtn
local function toggleMenu(state)
    isOpen = state
    if isOpen then
        Main.Visible = true
        TweenService:Create(Main, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0.5, -250, 0.5, -160)}):Play()
        FloatBtn.Visible = false
    else
        TweenService:Create(Main, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position = UDim2.new(1, 100, 0.5, -160)}):Play()
        task.delay(0.3, function() if not isOpen then Main.Visible = false; FloatBtn.Visible = true end end)
    end
end
CloseBtn.MouseButton1Click:Connect(function() toggleMenu(false) end)
UserInputService.InputBegan:Connect(function(input, gp) if not gp and input.KeyCode == Enum.KeyCode.RightShift then toggleMenu(not isOpen) end end)

